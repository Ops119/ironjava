# Copy to .env and fill the values you actually have.
# Placeholders only. Do not put real private keys in git.

POSTGRES_DB=ironjava
POSTGRES_USER=ironjava
POSTGRES_PASSWORD=change-me

IRONJAVA_AUTH_USERNAME=ironjava
IRONJAVA_AUTH_PASSWORD=change-me
IRONJAVA_API_TOKEN=

# Single process on a workstation. Compose overrides these per service.
IRONJAVA_ROLE=ALL
IRONJAVA_WORKER_ENABLED=true
IRONJAVA_CONTROL_LOOP_ENABLED=true
IRONJAVA_RUNNER_MODE=process
IRONJAVA_MAVEN_BINARY=mvn
IRONJAVA_OSV_SCANNER=osv-scanner
IRONJAVA_WORKSPACE_ROOT=/tmp/ironjava-workspaces

# Acceptance fixture. Clone it first; do not vendor it into this repo.
IRONJAVA_FIXTURE_SOURCE=local
IRONJAVA_FIXTURE_LOCAL_PATH=
IRONJAVA_FIXTURE_TEST_FAILURE_PATH=
IRONJAVA_FIXTURE_BRANCH=cursor/ironjava-acceptance-fixture-68a8

# Required only for a real draft pull request. Leave blank to stop at PUBLICATION_NOT_CONFIGURED.
IRONJAVA_GITHUB_APP_ID=
IRONJAVA_GITHUB_PRIVATE_KEY_PATH=
IRONJAVA_GITHUB_INSTALLATION_ID=0
IRONJAVA_GITHUB_API_BASE=https://api.github.com

# disabled selects the lowest server-supplied candidate and calls no model.
# required calls the configured endpoint and blocks with MODEL_UNAVAILABLE when it is missing.
IRONJAVA_MODEL_MODE=disabled
IRONJAVA_MODEL_ENDPOINT=
IRONJAVA_MODEL_NAME=
IRONJAVA_MODEL_API_KEY_PATH=
IRONJAVA_MODEL_INPUT_PRICE=0
IRONJAVA_MODEL_OUTPUT_PRICE=0
